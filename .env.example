# Backend Application Port
PORT=5000

# Environment Mode
NODE_ENV=production

# PostgreSQL Database Connection String
# Example for local cPanel Postgres: postgres://cpaneluser_dbuser:StrongPassword@localhost:5432/cpaneluser_plastix
# Example for Neon/Cloud Postgres: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://username:password@localhost:5432/plastix_factory

# Security Secrets (generate random long strings for production)
JWT_SECRET=replace_with_a_long_random_jwt_secret_key_32_chars_plus
COOKIE_SECRET=replace_with_a_long_random_cookie_secret_key_32_chars_plus

# Allowed Frontend Origins for CORS & Socket.IO (comma-separated if multiple)
# Example: https://yourdomain.com,https://www.yourdomain.com
FRONTEND_URL=https://yourdomain.com
